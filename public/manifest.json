{
  "manifest_version": 2,
  "name": "AI Reply Generator",
  "version": "1.0",
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "message_display_action": {
    "default_title": "AI Reply Generator"
  },  
  "permissions": [
    "messagesRead",
    "menus",
    "activeTab",
    "tabs"    
  ]
}
